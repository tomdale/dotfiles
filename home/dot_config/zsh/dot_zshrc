# ───────────────────────────────────────────────────────────────────────────────
# Tool Integrations
# Each tool adds hooks to zsh for enhanced functionality
# ───────────────────────────────────────────────────────────────────────────────
# zoxide emits sizeable function/completion definitions. Its command shims load
# that integration on first use, keeping normal shell startup lean.
__tomdale_load_zoxide() {
  unfunction z zi __tomdale_load_zoxide
  eval "$(command zoxide init zsh --cmd z)"
}
z() {
  __tomdale_load_zoxide
  z "$@"
}
zi() {
  __tomdale_load_zoxide
  zi "$@"
}
# Keep the direnv hook local instead of starting direnv merely to print this
# five-line function at every shell startup.
_direnv_hook() {
  trap -- '' SIGINT
  eval "$(command direnv export zsh)"
  trap - SIGINT
}
# The generated hook checks direnv on every prompt. Keep directory changes
# immediate, while limiting unchanged-directory refreshes to once a second.
zmodload zsh/datetime
typeset -gF __TOMDALE_DIRENV_LAST_CHECK=0
__tomdale_direnv_precmd() {
  local -F now=$EPOCHREALTIME
  (( now - __TOMDALE_DIRENV_LAST_CHECK >= 1 )) || return
  __TOMDALE_DIRENV_LAST_CHECK=$now
  _direnv_hook
}
add-zsh-hook -d precmd _direnv_hook
precmd_functions=(__tomdale_direnv_precmd $precmd_functions)
# These integrations only generate small, stable shell functions. Define them
# directly so opening a shell doesn't spawn two helper processes first.
# Write OSC sequences to the tty asynchronously: running them synchronously in
# zle-line-init blocks first_command_lag and can force a full prompt redraw
# (~180 ms on this machine). Background + /dev/tty keeps the line editor free.
_termtint_hook() { ( command termtint apply > /dev/tty ) &! }
add-zsh-hook chpwd _termtint_hook
_termtitle_hook() { ( command termtitle apply > /dev/tty ) &! }
add-zsh-hook chpwd _termtitle_hook
# Kick off decorations once the first prompt is already on screen. Proto project
# env is intentionally not activated here: shims resolve tool versions on
# demand, and the chpwd hook above runs `proto activate --export` when the
# working directory changes.
__tomdale_apply_initial_terminal_decorations() {
  _termtint_hook
  _termtitle_hook
  zle -D zle-line-init
  unfunction __tomdale_apply_initial_terminal_decorations
}
zle -N zle-line-init __tomdale_apply_initial_terminal_decorations

# workforest shell integration (wf new/switch/delete auto-cd). The generated
# snippet is static; regenerating it via `wf shell init zsh` costs ~2s because
# wf is a Node CLI. Cache it and only refresh when the binary is newer.
{
  local wf_bin wf_cache
  wf_bin="${commands[wf]:-}"
  wf_cache="$XDG_CACHE_HOME/zsh/wf-shell-init.zsh"
  if [[ -n $wf_bin ]]; then
    # Resolve through one level of symlink so rebuilds of the linked checkout
    # invalidate the cache even when the ~/.local/bin/wf link mtime is stale.
    [[ -L $wf_bin ]] && wf_bin="${wf_bin:A}"
    if [[ ! -s $wf_cache || $wf_bin -nt $wf_cache ]]; then
      mkdir -p "${wf_cache:h}"
      # Prefer the real binary so PATH lookups don't re-enter a shell function.
      if command "$wf_bin" shell init zsh >| "$wf_cache" 2>/dev/null; then
        :
      else
        rm -f "$wf_cache"
      fi
    fi
    [[ -s $wf_cache ]] && source "$wf_cache"
  fi
}

# ───────────────────────────────────────────────────────────────────────────────
# Lazy secret injection (keychain → shell memory; zero disk)
# Interactive: process-sub pipe + `zle -F`. The producer runs in parallel with
# the rest of startup; when ZLE waits for the first keystroke it notices the fd,
# drains export lines, evals them in THIS shell, and closes the fd. No tempfile.
# (Earlier pipe attempts looked broken only because the Python pty harness never
# drove ZLE's input loop — under a real tty `zle -F` fires reliably on zsh 5.9.)
# Non-interactive shells use ~/.zshenv's synchronous fallback.
# ───────────────────────────────────────────────────────────────────────────────
if [[ -z ${AI_GATEWAY_API_KEY-} || -z ${SOCKET_AUTH_B64-} ]]; then
  zmodload zsh/system 2>/dev/null
  __tomdale_emit_secrets() {
    emulate -L zsh
    if [[ -z ${AI_GATEWAY_API_KEY-} && -x /usr/bin/security ]]; then
      local v
      v="$(/usr/bin/security find-generic-password \
        -a vercel-ai-gateway -s 'Vercel AI Gateway' -w 2>/dev/null)"
      [[ -n $v ]] && print -r -- "export AI_GATEWAY_API_KEY=${(q+)v}"
    fi
    if [[ -f $HOME/.config/socket-firewall/env.sh ]]; then
      source "$HOME/.config/socket-firewall/env.sh"
      print -r -- "export SOCKET_AUTH_B64=${(q+)SOCKET_AUTH_B64}"
      print -r -- "export SOCKET_PASSWORD_B64=${(q+)SOCKET_PASSWORD_B64}"
      print -r -- "export UV_INDEX_SOCKET_FIREWALL_USERNAME=${(q+)UV_INDEX_SOCKET_FIREWALL_USERNAME:-client-gate}"
      print -r -- "export UV_INDEX_SOCKET_FIREWALL_PASSWORD=${(q+)UV_INDEX_SOCKET_FIREWALL_PASSWORD}"
    fi
  }
  __tomdale_collect_secret_fd() {
    emulate -L zsh
    local fd=$1 _err=${2-} line body=""
    # Drain fully (data path and hup/err). Producer writes complete export lines.
    while IFS= read -r -u $fd line || [[ -n $line ]]; do
      body+="$line"$'\n'
      line=""
    done
    zle -F $fd 2>/dev/null
    exec {fd}<&- 2>/dev/null
    [[ -n $body ]] && eval "$body"
    unfunction __tomdale_collect_secret_fd __tomdale_emit_secrets 2>/dev/null
  }
  # gitstatus-style open (cloexec). exec {fd}< is the portable fallback.
  if ! sysopen -r -o cloexec -u __tomdale_secret_fd <( __tomdale_emit_secrets ) 2>/dev/null; then
    exec {__tomdale_secret_fd}< <( __tomdale_emit_secrets )
  fi
  zle -F $__tomdale_secret_fd __tomdale_collect_secret_fd
  unset __tomdale_secret_fd
fi

# ───────────────────────────────────────────────────────────────────────────────
# iTerm2 Integration
# Ghostty (and other terminals) ship their own shell integration. Loading the
# iTerm2 script outside iTerm still installs precmd hooks that fork base64 for
# every user var on every prompt (~70 ms here). Gate on TERM_PROGRAM.
# ───────────────────────────────────────────────────────────────────────────────
if [[ ${TERM_PROGRAM-} == iTerm.app ]]; then
  [[ -f $ZDOTDIR/iterm2_user_vars.zsh ]] && source "$ZDOTDIR/iterm2_user_vars.zsh"
  [[ -e $ZDOTDIR/.iterm2_shell_integration.zsh ]] && source "$ZDOTDIR/.iterm2_shell_integration.zsh"
fi
