{{- $isWork := promptBoolOnce . "isWork" "Is this a work machine" -}}
{{- $npmPublishTokenOpRef := "" -}}
{{- if $isWork -}}
{{- $npmPublishTokenOpRef = promptStringOnce . "npmPublishTokenOpRef" "1Password secret reference for npm publish token (blank to skip)" "" -}}
{{- end -}}

[data]
    isWork = {{ $isWork }}
    npmPublishTokenOpRef = {{ $npmPublishTokenOpRef | quote }}

[merge]
command = "bash"
args = [
    "-c",
    'cp "$1" "$2" && code --wait --new-window --merge "$3" "$1" "$2" "$4"',
    "bash",
    "{{ `{{ .Target }}` }}",
    "{{ `{{ .Target }}` }}.base",
    "{{ `{{ .Destination }}` }}",
    "{{ `{{ .Source }}` }}",
]
