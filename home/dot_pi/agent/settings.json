{
  "lastChangelogVersion": "0.84.0",
  "defaultProvider": "vercel-ai-gateway",
  "defaultModel": "openai/gpt-5.6-luna",
  "defaultThinkingLevel": "xhigh",
  "theme": "dark",
  "externalEditor": "code --wait",
  "hideThinkingBlock": false,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "quietStartup": false,
  "defaultProjectTrust": "ask",
  "enableSkillCommands": true,
  "enableInstallTelemetry": false,
  "collapseChangelog": true,
  "autocompleteMaxVisible": 10,
  "outputPad": 1,
  "enabledModels": [
    "ollama/gemma-4-26b-a4b-it-q4_k_m-128k",
    "vercel-ai-gateway/anthropic/claude-haiku-4.5",
    "vercel-ai-gateway/openai/gpt-5.6-luna",
    "vercel-ai-gateway/openai/gpt-5.6-sol",
    "vercel-ai-gateway/zai/glm-5.2",
    "vercel-ai-gateway/zai/glm-5.2-fast",
    "vercel-ai-gateway/anthropic/claude-sonnet-5",
    "vercel-ai-gateway/anthropic/claude-opus-5",
    "vercel-ai-gateway/openai/gpt-5.6-terra",
    "vercel-ai-gateway/deepseek/deepseek-v4-flash",
    "vercel-ai-gateway/deepseek/deepseek-v4-flash-0731",
    "vercel-ai-gateway/xai/grok-4.5",
    "vercel-ai-gateway/moonshotai/kimi-k3",
    "vercel-ai-gateway/deepseek/deepseek-v4-pro"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 32000
  },
  "branchSummary": {
    "reserveTokens": 32768,
    "skipPrompt": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "transport": "auto",
  "httpIdleTimeoutMs": 300000,
  "websocketConnectTimeoutMs": 15000,
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60,
    "clearOnShrink": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "markdown": {
    "codeBlockIndent": "  "
  },
  "skills": [
    "~/.agents/skills"
  ],
  "prompts": [
    "prompts"
  ],
  "extensions": [
    "extensions/claude-rules.ts",
    "extensions/plan-mode",
    "extensions/preset.ts",
    "extensions/protected-paths.ts"
  ],
  "packages": [
    "../../Code/Repos/toolbelt/main/claude-plugin-loader",
    "npm:pi-mcp-adapter@2.17.0",
    "npm:pi-web-search@1.3.1",
    "../../Code/Repos/pi-subagents",
    "../../Code/Repos/pi-dynamic-workflows",
    "npm:@capyup/pi-goal@0.6.0",
    "npm:@harms-haus/pi-cwd@1.0.0",
    "npm:@juicesharp/rpiv-todo@2.4.0",
    "npm:sideshow"
  ]
