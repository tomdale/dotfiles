#!/usr/bin/env zsh
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ ~/.zshenv - Bootstrap ZDOTDIR                                            ║
# ╠═══════════════════════════════════════════════════════════════════════════╣
# ║ This file only runs when ZDOTDIR is unset — i.e. the very first shell   ║
# ║ in a session (new terminal tab, SSH login). It sets ZDOTDIR so that all  ║
# ║ subsequent zsh files (.zshrc, .zprofile) are loaded from ~/.config/zsh.  ║
# ║                                                                           ║
# ║ Subshells inherit ZDOTDIR from their parent, so zsh looks for .zshenv   ║
# ║ in $ZDOTDIR instead of ~. That's why $ZDOTDIR/.zshenv also exists —     ║
# ║ it handles the subshell/non-interactive case. See the architecture note  ║
# ║ in env.zsh for the full startup flow.                                    ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Relocate zsh config to XDG-compliant location
export ZDOTDIR="$HOME/.config/zsh"

# Source environment variables and PATH (separated for clarity).
# env.zsh also owns the non-interactive keychain secret fallback (shared with
# $ZDOTDIR/.zshenv so subshells that inherit ZDOTDIR get the same path).
source "$ZDOTDIR/env.zsh"
