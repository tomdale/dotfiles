#!/bin/sh
set -eu

usage() {
  echo "usage: agent-upload [--path BLOB_PATH] [--content-type MIME_TYPE] FILE" >&2
  exit 2
}

blob_path=
content_type=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --path)
      [ "$#" -ge 2 ] || usage
      blob_path=$2
      shift 2
      ;;
    --content-type)
      [ "$#" -ge 2 ] || usage
      content_type=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -* )
      usage
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -ne 1 ]; then
  usage
fi

file=$1
if [ ! -f "$file" ]; then
  echo "agent-upload: not a regular file: $file" >&2
  exit 1
fi

# Keep the credential in 1Password; the reference identifies metadata only.
token="$(op read 'op://ygmwu4owexpyapcygqijuxwcd4/mhco3skxjrylo5tm6yywg4lwxm/password')"
if [ -z "$token" ]; then
  echo "agent-upload: 1Password returned an empty blob token" >&2
  exit 1
fi

if [ -z "${USER_PREFIX-}" ]; then
  echo "agent-upload: USER_PREFIX is not set" >&2
  exit 1
fi

if [ -z "$blob_path" ]; then
  blob_path=$(basename "$file")
fi
case "$blob_path" in
  "$USER_PREFIX"/*)
    pathname=$blob_path
    ;;
  *)
    pathname="$USER_PREFIX/$blob_path"
    ;;
esac

if [ -z "$content_type" ]; then
  content_type=$(file --mime-type --brief "$file" 2>/dev/null || true)
fi
if [ -z "$content_type" ] || [ "$content_type" = application/octet-stream ]; then
  content_type=application/octet-stream
fi
encoded_pathname=$(printf '%s' "$pathname" | jq -sRr @uri)
response="$({
  curl --fail-with-body --silent --show-error --request PUT \
    --url "https://blob.vercel-storage.com/$encoded_pathname" \
    --header 'x-vercel-blob-access: public' \
    --header "authorization: Bearer $token" \
    --header "x-content-type: $content_type" \
    --data-binary "@$file"
} 2>&1)" || {
  echo "$response" >&2
  exit 1
}

url=$(printf '%s' "$response" | jq -er '.url') || {
  echo "agent-upload: upload response did not contain a public URL" >&2
  printf '%s\n' "$response" >&2
  exit 1
}
printf '%s\n' "$url"
