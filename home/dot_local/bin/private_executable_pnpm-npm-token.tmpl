#!/bin/sh
set -eu

{{- $isWork := get . "isWork" | default false -}}
{{- $npmPublishTokenOpRef := get . "npmPublishTokenOpRef" | default "" }}

# Returns the brief authorization header that publishes to npmjs need, so that
# `pnpm-publish` and `npm-rw` can hand it to a single command.
#
# Package reads never call this. They resolve through the Socket Firewall
# registry in .npmrc, which authenticates with its own credentials, so installing
# dependencies must not touch 1Password at all.
usage() {
  echo "usage: pnpm-npm-token --publish" >&2
  exit 2
}

if [ "$#" -ne 1 ] || [ "$1" != "--publish" ]; then
  usage
fi

{{- if and $isWork $npmPublishTokenOpRef }}
printf 'Bearer '
op read {{ $npmPublishTokenOpRef | quote }}
{{- else }}
echo "npm publish token 1Password reference is not configured" >&2
exit 1
{{- end }}
